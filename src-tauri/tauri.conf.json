{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Densync",
  "version": "2.0.0",
  "identifier": "com.densync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Densync",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Densync Team",
    "copyright": "© 2026 Densync Team",
    "shortDescription": "Densync AI Factory Analytics",
    "longDescription": "Densync is a comprehensive real-time factory analytics and AI management dashboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "License.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
